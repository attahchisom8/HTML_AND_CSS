/** VARIABLES */
:root {
    --primary-color: #DFFF22;
    --btn-color: #1177FF;
}

*, *::before, *::after {
    box-sizing:border-box;
}
body {
    width: 100vw;
    margin: 0;
    padding: 0;
    overflow-x: hidden; /* Strict horizontal lock */
    position: relative
}

/* LIGHT MODE */

body.light {
    color: black;
    background: white;
}

body.light .navbar {
    background: white;
}
body.light .bar {
    background: black;
}

    /**-- NAVBAR SECTION --**/

/* MOBILE MODE */

.navbar {
    display: flex;
    justify-content: space-between;
    position: fixed;
    padding: 30px;
    width: 100%;
   background: rgba(0, 0, 0,  0.5);
    z-index: 1000;
    backdrop-filter: blur(20px);
}

.nav-div {
    /*position: relative; */
    /* width: 100%; */
}

.nav-links {
    /* display: none */
    position: absolute;
    top: 42px;
    left: 0;
    padding: 20px;
    background: rgba(26, 26, 112, 0.87); /* #1A1A70 */
    gap: 10px;
    list-style: none;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
    transition: all 0.4s ease;
}

.nav-links.active {
    /* display: flex;
    flex-direction: column; */
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.nav-links li a {
    color: white;
    text-decoration: none;
    font-size: 20px;
}

.menu-toggle {
    position: absolute;
    left: 100px;
    top: 20px;
}

.menu-toggle .bar {
    display: block;
    height: 3px;
    width: 25px;
    background: white;
    margin: 5px;
}

#menuToggleMobile.is-active .bar:nth-child(2) {
    opacity: 0;
}

#menuToggleMobile.is-active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}

#menuToggleMobile.is-active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
}

.logo {
    position: absolute;
    left: 10px;
    top: 0px;
    background: var(--btn-color);
    padding: 3px;
}

.logo a {
    text-decoration: none;
    color: var(--primary-color);
}


.theme-toggle {
    position: absolute;
    right: 30px;
}


/* NAVBAR -Desktop mods */

@media (min-width: 768px) {
    .nav-div {
        width: 100%;
        /*position: relative;*/
    }
    
    .nav-links {
        display: flex;
        flex-direction: row;
        gap: 10px;
        opacity: 1;
        visibility: visible;
        background: transparent;
        /*align-items: center;*/
        /*justify-content: center;*/
        position: static;
    }
    
    .menu-toggle {
        display: none;
    }
    
    .logo {
        position: relative;
        padding: 10px;
    }
    .logo a {
        text-align: center;
    }
}



    /** HERO SECTION */

/* MOBILE MODE */
.hero {
    padding-top: 80px;
    display: flex;
    flex-direction: column;
    position: relative;
    align-items: center;
    justify-content: center;
    /* background: #333; */
    color: white;
    height: 100vh;
    width: 100%;
    gap: 15px;
    text-align: center;
    overflow: hidden;
}

.hero p {
    width: 100%;
}

.hero span {
    color: var(--primary-color);
}

.hero a {
    text-decoration: none;
    color: var(--btn-color);
    font-weight: bold;
    font-size: 1.5rem;
}

.hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    animation: rotateImg 10s infinite;
    z-index: -2
}

@keyframes rotateImg {
    0% {
        background-image: url("./images/hero1.jpg");
        transform: scale(1);
    }
    12% {
        transform: scale(1.1);
    }
    25% {
        background-image: url("./images/hero2.jpg");
        transform: scale(1);
    }
    37% {
        transform: scale(1.1);
    }
    50% {
        background-image: url("./images/Hero3.jpg");
        transform: scale(1);
    }
    62% {
        transform: scale(1.1);
    }
    75% {
        background-image: url("./images/hero4.jpg");
        transform: scale(1);
    }
    87% {
        transform: scale(1.1);
    }
    100% {
        background-image: url("./images/hero1.jpg");
        transform: scale(1);
    }
}

.hero::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0.2, 0.65);
    z-index: -1;
}

/* HERO SECTION -DESKTOP MODE */
@media (min-width: 768px) { 
    .hero {
        padding-top: 12px;
        flex-direction: row;
        height: 100vh;
    }

    .hero::before {
        background-position: 30px 15px;
    }
}


